    {
      "id": "bC_PtHC8UJE9lFFLH6GkO",
      "type": "text",
      "x": 3214.256229568852,
      "y": 9628.542349535126,
      "width": 743.3997032642365,
      "height": 340.2,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7p",
