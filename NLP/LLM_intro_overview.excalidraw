    {
      "id": "oHb2pHdiFP5IdSPTxdCYb",
      "type": "text",
      "x": 407.67082550465693,
      "y": 8115.308615288852,
      "width": 872.2200427861351,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7f",
      "roundness": null,
      "seed": 482318921,
      "version": 2313,
      "versionNonce": 955939017,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1738711429595,
      "link": null,
      "locked": false,
      "text": "RLHF upside",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RLHF upside",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "DM8Qo9jGs32F8OrK9QaAU",
      "type": "text",
      "x": 409.84377410473644,
      "y": 8188.370677226441,
      "width": 1168.0468749999989,
      "height": 340.2,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7g",
      "roundness": null,
      "seed": 665309289,
      "version": 695,
      "versionNonce": 782399401,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1738711429595,
      "link": null,
      "locked": false,
      "text": "We can run RL, in arbitrary domains! (even the unverifiable ones)\nThis (empirically) improves the performance of the model, possibly due\nto the \"discriminator - generator gap\":\n\nIn many cases, it is much easier to discriminate than to generate.\n\ne.g. \"Write a poem\" vs. \"Which of these 5 poems is best?\"",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We can run RL, in arbitrary domains! (even the unverifiable ones)\nThis (empirically) improves the performance of the model, possibly due to the \"discriminator - generator gap\":\n\nIn many cases, it is much easier to discriminate than to generate.\n\ne.g. \"Write a poem\" vs. \"Which of these 5 poems is best?\"",
      "autoResize": false,
      "lineHeight": 1.35
    },
    {
      "id": "wJOoQqmfd7YKi5eyXKAAD",
      "type": "text",
      "x": 409.3809050553891,
      "y": 8684.205457932889,
      "width": 872.2200427861351,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7i",
      "roundness": null,
      "seed": 1936392937,
      "version": 2375,
      "versionNonce": 1890032265,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1738711429595,
      "link": null,
      "locked": false,
      "text": "RLHF downside",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RLHF downside",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "AGAwJ2JyOkMIuNWJEWRF3",
      "type": "text",
      "x": 408.94148818688063,
      "y": 8754.424053286153,
      "width": 1168.0468749999989,
      "height": 486,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7j",
      "roundness": null,
      "seed": 759818055,
      "version": 1397,
      "versionNonce": 1069900137,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1738711429595,
      "link": null,
      "locked": false,
      "text": "We are doing RL with respect to a lossy simulation of humans. It might\nbe misleading!\n\nEven more subtle:\nRL discovers ways to \"game\" the model.\nIt discovers \"adversarial examples\" of the reward model.\n\nE.g. after 1,000 updates, the top joke about pelicans is not the banger\nyou want, but something totally non-sensical like \"the the the the the\nthe the the\".",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We are doing RL with respect to a lossy simulation of humans. It might be misleading!\n\nEven more subtle:\nRL discovers ways to \"game\" the model.\nIt discovers \"adversarial examples\" of the reward model.\n\nE.g. after 1,000 updates, the top joke about pelicans is not the banger you want, but something totally non-sensical like \"the the the the the the the the\".",
      "autoResize": false,
      "lineHeight": 1.35
    },
    {
      "id": "LJoYwLNRHa6jD--W9fHj6",
      "type": "line",
      "x": 359.6435749131542,
      "y": 9406.2729042066,
      "width": 3582.0607976323727,
      "height": 0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7o",
