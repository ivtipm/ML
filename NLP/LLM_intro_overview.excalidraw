    {
      "id": "JU3tWvzTd9gu5PsD3aMhn",
      "type": "text",
      "x": 441.658624687651,
      "y": 616.1827794459373,
      "width": 595.6684027777777,
      "height": 243,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1v",
      "roundness": null,
      "seed": 678007903,
      "version": 1016,
      "versionNonce": 544158911,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1733857247177,
      "link": null,
      "locked": false,
      "text": "Converts text <---> sequences of symbols (/tokens)\n- Start with stream of bytes (256 tokens)\n- Run the Byte Pair Encoding algorithm (iteratively merge the\nmost common token pair to mint new token)\n\nExample: ~5000 text characters\n~= 40,000 bits (with vocabulary size of 2 tokens: bits 0/1)\n~= 5000 bytes (with vocabulary size of 256 tokens: bytes)\n~= 1300 GPT-4 tokens (vocabulary size 100,277)",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Converts text <---> sequences of symbols (/tokens)\n- Start with stream of bytes (256 tokens)\n- Run the Byte Pair Encoding algorithm (iteratively merge the most common token pair to mint new token)\n\nExample: ~5000 text characters\n~= 40,000 bits (with vocabulary size of 2 tokens: bits 0/1)\n~= 5000 bytes (with vocabulary size of 256 tokens: bytes)\n~= 1300 GPT-4 tokens (vocabulary size 100,277)",
      "autoResize": false,
      "lineHeight": 1.35
    },
