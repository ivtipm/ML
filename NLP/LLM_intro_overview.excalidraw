    {
      "id": "PhsoZup3ZdGh-JCf_eR7d",
      "type": "text",
      "x": 3060.592348021572,
      "y": 1267.0209987938379,
      "width": 1087.9783039093018,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4g",
      "roundness": null,
      "seed": 1658068142,
      "version": 1484,
      "versionNonce": 141284145,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1738108663343,
      "link": null,
      "locked": false,
      "text": "- It is a token-level internet document simulator\n- It is stochastic / probabilistic - you're going to get something else each time you run\n- It \"dreams\" internet documents\n- It can also recite some training documents verbatim from memory (\"regurgitation\")\n- The parameters of the model are kind of like a lossy zip file of the internet\n    => a lot of useful world knowledge is stored in the parameters of the network\n- You can already use it for applications (e.g. translation) by being clever with your prompts\n    - e.g. English:Korean translator app by constructing a \"few-shot\" prompt and leveraging \"in-context learning\" ability\n    - e.g. an Assistant that answers questions using a prompt that looks like a conversation\n- But we can do better...",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- It is a token-level internet document simulator\n- It is stochastic / probabilistic - you're going to get something else each time you run\n- It \"dreams\" internet documents\n- It can also recite some training documents verbatim from memory (\"regurgitation\")\n- The parameters of the model are kind of like a lossy zip file of the internet\n    => a lot of useful world knowledge is stored in the parameters of the network\n- You can already use it for applications (e.g. translation) by being clever with your prompts\n    - e.g. English:Korean translator app by constructing a \"few-shot\" prompt and leveraging \"in-context learning\" ability\n    - e.g. an Assistant that answers questions using a prompt that looks like a conversation\n- But we can do better...",
      "autoResize": true,
      "lineHeight": 1.35
    },
