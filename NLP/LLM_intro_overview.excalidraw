      "index": "b4b",
      "roundness": null,
      "seed": 1115924722,
      "version": 337,
      "versionNonce": 1673739566,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1733952853342,
      "link": null,
      "locked": false,
      "text": "What is a release of a model?\n1) The code for running the Transformer  (e.g. 200 lines of code in Python)\n2) The parameters of the Transformer      (e.g. 1.6 billion numbers)",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What is a release of a model?\n1) The code for running the Transformer  (e.g. 200 lines of code in Python)\n2) The parameters of the Transformer      (e.g. 1.6 billion numbers)",
      "autoResize": false,
      "lineHeight": 1.35
    },
