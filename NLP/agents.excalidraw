  "elements": [
    {
      "id": "vC-LkV3nNhXud-fq9zGEF",
      "type": "text",
      "x": 310.0048828125,
      "y": 238.0078125,
      "width": 731.9954223632814,
      "height": 351,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0",
      "roundness": null,
      "seed": 785333434,
      "version": 95,
      "versionNonce": 1448838118,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765445399200,
      "link": null,
      "locked": false,
      "text": "ИИ‑агент (AI agent) — это автономная программная система, которая\nвзаимодействует со средой, принимает решения и действует в этой среде\nдля достижения заданных целей.\n\n\nВ информатике под агентом понимается вычислительная система,\nрасположенная в некоторой среде, способная самостоятельно действовать\nв этой среде для достижения заданных целей. \n\n\nАгент — это не просто функция или модель, а целостный субъект\nвзаимодействия \n“восприятие → внутреннее состояние/принятие решения → действие”",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ИИ‑агент (AI agent) — это автономная программная система, которая взаимодействует со средой, принимает решения и действует в этой среде для достижения заданных целей.\n\n\nВ информатике под агентом понимается вычислительная система, расположенная в некоторой среде, способная самостоятельно действовать в этой среде для достижения заданных целей. \n\n\nАгент — это не просто функция или модель, а целостный субъект взаимодействия \n“восприятие → внутреннее состояние/принятие решения → действие”",
      "autoResize": false,
      "lineHeight": 1.35
    },
