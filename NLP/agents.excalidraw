    {
      "id": "Y7oQCEpcpFZFbET3EPsTk",
      "type": "text",
      "x": 310.0048834079886,
      "y": 1177.6320218645506,
      "width": 777.8453825920114,
      "height": 259.20000000000005,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
