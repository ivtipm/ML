    },
    {
      "id": "2qPaSn5t9XIsVAtIE2l4t",
      "type": "text",
      "x": 2283.4944368166744,
      "y": 511.84389788262956,
      "width": 296.5125732421875,
      "height": 64.80000000000001,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0P",
      "roundness": null,
      "seed": 808447262,
      "version": 704,
      "versionNonce": 1873844290,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "GV-U4Y2Y8Fli3knzyrJAf",
          "type": "arrow"
        }
      ],
      "updated": 1791399522342,
      "link": null,
      "locked": false,
      "text": "Применяется механизм многомерного \nвнимания (self attention) → \nагрегация многомерного внимания",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Применяется механизм многомерного \nвнимания (self attention) → \nагрегация многомерного внимания",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "Lnj-l7p63GolK6ALkThQr",
      "type": "text",
      "x": 2285.050901878477,
      "y": 781.5126931375403,
      "width": 379.79278564453125,
      "height": 86.4,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Q",
      "roundness": null,
      "seed": 302042882,
      "version": 985,
      "versionNonce": 741883906,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "GV-U4Y2Y8Fli3knzyrJAf",
          "type": "arrow"
        }
      ],
      "updated": 1791399522342,
      "link": null,
      "locked": false,
      "text": "Предсказание следующего токена\nСчитает логиты (logits) для вариантов токенов\nПрименяет softmax\nВыбирает токен в соответствии с вероятностиями",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
