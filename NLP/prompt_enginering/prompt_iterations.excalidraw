      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Три диких котёнка\nНа пути к работе встали,\nВремя замедлилось.",
      "autoResize": true,
      "lineHeight": 1.35
    },
