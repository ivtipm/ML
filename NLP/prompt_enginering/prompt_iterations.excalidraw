      "versionNonce": 993963122,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1759074430297,
      "link": null,
      "locked": false,
      "text": "shot-based prompting",
      "fontSize": 28,
      "fontFamily": 6,
