      "text": "Zero-Shot, One-Shot и Few-Shot Prompting",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Zero-Shot, One-Shot и Few-Shot Prompting",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "YZxPmTAbXCuyl7ioEn22p",
      "type": "text",
      "x": 3122.498301403556,
      "y": -383.21691578459894,
      "width": 282.35321044921875,
      "height": 37.800000000000004,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0E",
