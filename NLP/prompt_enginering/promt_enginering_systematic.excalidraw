      "type": "text",
      "x": 1524.1603868290513,
      "y": 244.9001879367957,
      "width": 493.4730224609375,
      "height": 43.2,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "#2f9e44",
      "fillStyle": "solid",
