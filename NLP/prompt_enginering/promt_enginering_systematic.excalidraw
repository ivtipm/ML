    {
      "id": "NutYuXYmBoUdVM2dljqJQ",
      "type": "text",
      "x": 1107.5023075139172,
      "y": 1170.3748400556447,
      "width": 378.3671352610736,
      "height": 108,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
