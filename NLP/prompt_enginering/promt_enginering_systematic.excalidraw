      "id": "iF1R8xyS4cd6W5mIS0oRs",
      "type": "text",
      "x": 1954.8089984143537,
      "y": 3042.0126165834954,
      "width": 462.7369384765625,
      "height": 40,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
