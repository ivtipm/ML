      "link": null,
      "locked": false,
      "text": "System 2 Attention (S2A): просим LLM  убрать из промпта всё лишнее,\nчтобы его было проще обработать",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "System 2 Attention (S2A): просим LLM  убрать из промпта всё лишнее,\nчтобы его было проще обработать",
      "autoResize": true,
      "lineHeight": 1.35
    },
