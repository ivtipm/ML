      "isDeleted": false,
      "boundElements": [],
      "updated": 1759167194496,
      "link": null,
      "locked": false,
      "text": "Re-reading (RE2): Еще раз прочитай вопрос",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Re-reading (RE2): Еще раз прочитай вопрос",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
