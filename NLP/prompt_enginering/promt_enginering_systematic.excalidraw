      "isDeleted": false,
      "boundElements": null,
      "updated": 1759380963142,
      "link": null,
      "locked": false,
      "text": "refine - уточнение, усовершенствование",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "refine - уточнение, усовершенствование",
      "autoResize": false,
      "lineHeight": 1.35
    },
