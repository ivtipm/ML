      "versionNonce": 762183649,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1759167152085,
      "link": null,
      "locked": false,
      "text": "Rephrase and Respond (RaR): Перефразируй и уточни вопрос, а затем дай ответ;\nМожно в одно или в два сообщения в чат",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Rephrase and Respond (RaR): Перефразируй и уточни вопрос, а затем дай ответ;\nМожно в одно или в два сообщения в чат",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "u7qs6NQ4AP6_It4hQgbuk",
      "type": "text",
      "x": 1524.1603868290515,
      "y": 183.8305209367957,
      "width": 328.7047119140625,
      "height": 21.6,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "#2f9e44",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aH",
